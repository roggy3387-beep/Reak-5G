<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <!-- 1. Cellular 5G/4G Optimization & Anti-EDGE -->
        <dict>
            <key>PayloadDescription</key>
            <string>Cellular signal optimization, blocking EDGE and forcing 1-second signal recovery</string>
            <key>PayloadDisplayName</key>
            <string>5G OP Cellular Master</string>
            <key>PayloadIdentifier</key>
            <string>com.apple.cellular.shikukami.5gop.ff</string>
            <key>PayloadType</key>
            <string>com.apple.cellular</string>
            <key>PayloadUUID</key>
            <string>11111111-1111-1111-1111-111111111111</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>AttachAPN</key>
            <dict>
                <key>AuthenticationType</key>
                <string>CHAP</string>
            </dict>
        </dict>

        <!-- 2. Wi-Fi Turbo Roaming & Discovery -->
        <dict>
            <key>PayloadDescription</key>
            <string>High-throughput Wi-Fi roaming compatible with all iOS versions</string>
            <key>PayloadDisplayName</key>
            <string>5G OP Wi-Fi Turbo</string>
            <key>PayloadIdentifier</key>
            <string>com.apple.wifi.shikukami.5gop.ff</string>
            <key>PayloadType</key>
            <string>com.apple.wifi.managed</string>
            <key>PayloadUUID</key>
            <string>22222222-2222-2222-2222-222222222222</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>AutoJoin</key>
            <true/>
            <key>Disabled</key>
            <false/>
        </dict>

        <!-- 3. Multi-Session Override DNS -->
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerAddresses</key>
                <array>
                    <string>1.1.1.1</string>
                    <string>1.0.0.1</string>
                    <string>8.8.8.8</string>
                    <string>8.8.4.4</string>
                </array>
                <key>ServerURL</key>
                <string>https://cloudflare-dns.com/dns-query</string>
            </dict>
            <key>PayloadDescription</key>
            <string>Overrides active session conflicts</string>
            <key>PayloadDisplayName</key>
            <string>5G OP Override DNS</string>
            <key>PayloadIdentifier</key>
            <string>com.dns.shikukami.5gop.ff</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>33333333-3333-3333-3333-333333333333</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
        </dict>
        
        <!-- 4. Security Passcode Policy -->
        <dict>
            <key>PayloadDescription</key>
            <string>Enforces security verification passcodes</string>
            <key>PayloadDisplayName</key>
            <string>5G OP Security Policy</string>
            <key>PayloadIdentifier</key>
            <string>com.apple.mobiledevice.passwordpolicy.ff</string>
            <key>PayloadType</key>
            <string>com.apple.mobiledevice.passwordpolicy</string>
            <key>PayloadUUID</key>
            <string>44444444-4444-4444-4444-444444444444</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>forcePIN</key>
            <true/>
            <key>minLength</key>
            <integer>2</integer>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>5G OP ✅</string>
    <key>PayloadIdentifier</key>
    <string>com.custom.5gop.ff.profile</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadRemovalPasscode</key>
    <string>FF</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>55555555-5555-5555-5555-555555555555</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
